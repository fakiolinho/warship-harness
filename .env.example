# Copy to .env and fill in. Never commit .env.
# The harness reads these from the environment; it does not load .env itself.
#   export $(grep -v '^#' .env | xargs)

# Required to run a real mission (not needed for selfcheck.py or pytest).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: where the task economics ledger is written.
# Default is ./ledger.jsonl in the working directory.
# WARSHIP_LEDGER=/var/lib/warship/ledger.jsonl

# Optional: never prompt for gate approvals; treat every "ask" as declined.
# Set this for cron, systemd, and CI runs, where nobody is watching.
# WARSHIP_NONINTERACTIVE=1

# Optional: LangSmith tracing (layer 3 monitoring).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
